# Copy to .env and fill in. `.env` is git-ignored; this file is not.
# Prisma reads .env via dotenv in prisma.config.ts; Next.js reads it natively.

# ---- Site ----------------------------------------------------------------
# Public origin. Absolute URLs in metadata (og:image, canonicals) build from it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Database — OPTIONAL --------------------------------------------------
# Leave this unset and the site serves the bundled snapshot in
# src/data/snapshot.json. That is enough to build, run and deploy the whole
# public site, because nothing public writes data until Phase 7.
#
# Set it to work on the schema or the seed, or to run against real Postgres.
# DATABASE_URL="postgresql://user:password@host:5432/rakuxon_city?sslmode=require"

# ---- Phase 4: enquiry pipeline -------------------------------------------
# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Address enquiry acknowledgements and staff notifications are sent from.
ENQUIRY_FROM_EMAIL="enquiries@rakuxoncity.com"
# Investor notifications go to their own restricted target, never the general inbox.
INVESTOR_NOTIFICATION_EMAIL="investors@rakuxoncity.com"

# Newsletter sign-ups mirror into this Resend audience. Optional — without it
# they are still recorded locally and can be backfilled later.
RESEND_AUDIENCE_ID=""

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# The values below are Cloudflare's public always-passes test pair, fine for
# local development. Replace both before deploying.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ---- Phase 5: admin ------------------------------------------------------
# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Media library uploads (Vercel Blob — see note in docs handoff).
BLOB_READ_WRITE_TOKEN=""

# Phase 6 — Cloudflare Turnstile. The site key is needed on the client too, so
# it is duplicated with a NEXT_PUBLIC_ prefix. Without both, forms still submit
# and the server logs that the challenge was absent — never that it passed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
